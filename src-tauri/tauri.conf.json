{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "4Y Notification Manager",
  "version": "0.1.0",
  "identifier": "com.4ystudio.notificationmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "4Y 通知提示音管理器",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "4Y 通知提示音管理器",
    "longDescription": "为 Debian 13 + KDE 6 + Wayland 打造的系统通知提示音管理客户端，可按键应用配置不同的提示音。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "pipewire-bin"]
      }
    }
  }
}
